# Home Manager module: symlinks dotfiles from this repo into $HOME.
#
# Enable in your NixOS / standalone Home Manager config:
#
#   imports = [ inputs.my-dotfiles.homeModules.default ];
#   dotfiles.enable = true;
#   dotfiles.neovim.enable = true;  # LSPs via languageServers below
#
# Toggle individual apps with dotfiles.<app>.enable (mkEnableOption defaults to false).
# Enabling `dotfiles.neovim` installs language servers (see `languageServers`
# below) and writes ~/.local/share/nvim/nix-lsp.lua for Neovim to enable them.
# Set `manageConfig` to also link ~/.config/nvim from this flake (store copy —
# not needed if you already symlink).
dotfilesSource: # Flake root passed from flake.nix (curried as the first argument).
{
  lib, # Home Manager / Nixpkgs helper functions.
  config, # The user's full Home Manager configuration.
  pkgs, # Nixpkgs packages for this user/system.
  ...
}:
let
  # Shorthand for option / conditional helpers.
  inherit (lib) mkIf mkEnableOption mkOption types mkMerge;

  # Resolved configuration namespace: `config.dotfiles.*`.
  cfg = config.dotfiles;
in
{
  # ── Options ───────────────────────────────────────────────────────────────
  options.dotfiles = {
    # Master switch; when false, this module installs nothing.
    enable = mkEnableOption "RoParis9 dotfiles";

    # Path to the dotfiles source tree (flake checkout or local path).
    source = mkOption {
      type = types.path;
      default = dotfilesSource;
      description = "Root directory of the dotfiles repository.";
    };

    # Per-application toggles so you can mix these dotfiles with other configs.
    emacs = {
      enable = mkEnableOption "Emacs init.el from dotfiles";
    };

    neovim = {
      enable = mkEnableOption "Neovim LSP packages from Nix";
      manageConfig = mkEnableOption "Manage ~/.config/nvim from dotfiles.source";
    };

    zsh = {
      enable = mkEnableOption ".zshrc from dotfiles";
    };

    tmux = {
      enable = mkEnableOption ".tmux.conf from dotfiles";
    };

    alacritty = {
      enable = mkEnableOption "Alacritty config from dotfiles";
    };

    wofi = {
      enable = mkEnableOption "Wofi style from dotfiles";
    };
  };

  # ── Configuration ─────────────────────────────────────────────────────────
  config = mkIf cfg.enable (
    mkMerge [
      # Emacs: init.el lives in ~/.emacs.d/ by default.
      (mkIf cfg.emacs.enable {
        home.file.".emacs.d/init.el".source = "${cfg.source}/init.el";
      })

      # Neovim: language servers on PATH (no Mason). Config linking is optional.
      # This attrset is the source of truth: Home Manager installs the packages
      # and writes ~/.local/share/nvim/nix-lsp.lua so Neovim enables the same set.
      (mkIf cfg.neovim.enable (
        let
          languageServers = {
            clangd.packages = [ pkgs.clang-tools ];
            gopls.packages = [
              pkgs.gopls
              pkgs.go
            ];
            rust_analyzer.packages = [ pkgs.rust-analyzer ];
            ts_ls.packages = [
              pkgs.typescript-language-server
              pkgs.nodejs
            ];
            ruff.packages = [ pkgs.ruff ];
            html.packages = [ pkgs.vscode-langservers-extracted ]; # also cssls / jsonls
            cssls.packages = [ ];
            jsonls.packages = [ ];
            tailwindcss.packages = [ pkgs.tailwindcss-language-server ];
            dockerls.packages = [ pkgs.dockerfile-language-server ];
            sqls.packages = [ pkgs.sqls ];
            yamlls.packages = [ pkgs.yaml-language-server ];
            lua_ls.packages = [
              pkgs.lua-language-server
              pkgs.stylua
            ];
            ocamllsp.packages = [ pkgs.ocamlPackages.ocaml-lsp ];
            nixd.packages = [
              pkgs.nixd
              pkgs.nixfmt
            ];
          };

          luaServers = lib.concatMapStrings (name: "  ${name} = {},\n") (
            lib.attrNames languageServers
          );
        in
        {
          home.packages = lib.unique (
            lib.concatLists (lib.mapAttrsToList (_: v: v.packages or [ ]) languageServers)
          );

          # Read by nvim/lua/plugins/lsp.lua via stdpath("data")/nix-lsp.lua.
          xdg.dataFile."nvim/nix-lsp.lua".text = ''
            -- Generated by Home Manager from the dotfiles flake. Do not edit.
            return {
            ${luaServers}}
          '';
        }
      ))

      # Optional: flake-managed nvim config (store copy). Skip if you already
      # symlink ~/.config/nvim → this repo (avoids clobbering / purity issues).
      (mkIf (cfg.neovim.enable && cfg.neovim.manageConfig) {
        xdg.configFile.nvim.source = "${cfg.source}/nvim";
      })

      # Zsh: top-level rc file.
      (mkIf cfg.zsh.enable {
        home.file.".zshrc".source = "${cfg.source}/.zshrc";
      })

      # Tmux: top-level config file.
      (mkIf cfg.tmux.enable {
        home.file.".tmux.conf".source = "${cfg.source}/.tmux.conf";
      })

      # Alacritty: TOML config under XDG config dir.
      (mkIf cfg.alacritty.enable {
        xdg.configFile."alacritty/alacritty.toml".source = "${cfg.source}/alacritty.toml";
      })

      # Wofi: launcher CSS theme.
      (mkIf cfg.wofi.enable {
        xdg.configFile."wofi/style.css".source = "${cfg.source}/wofi/style.css";
      })
    ]
  );
}
